# Vorschaltdienst wie bei den anderen Apps auf dem Pi: TLS mit dem Blattzertifikat der Hausstelle und HTTP/2 auf 8661,
# das Backend dahinter ohne TLS und von außen nicht erreichbar. Beim Zugriff per IP steht kein Servername im Handschlag,
# darum default_sni: der Name codeschmiede.local steht in jedem Zertifikat der App (das Ausrollen nimmt ihn immer auf).
# Kein HSTS: unter einem Rechnernamen würde es alle Ports des Pi auf HTTPS zwingen.
{
	admin off
	auto_https off
	default_sni codeschmiede.local
}

:8661 {
	tls /zertifikate/codeschmiede.pem /zertifikate/codeschmiede-schluessel.pem
	# Zugriffe ins Protokoll des Containers (docker compose logs vorne): zeigt, was Geräte wirklich abfragen
	log {
		output stdout
		format json
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# Skripte und Gestaltung tragen Prüfsummen im Namen und ändern sich nie; die Startseite kommt ohne Zwischenspeicher
	@ewig path /assets/*
	header @ewig Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy codeschmiede:8200
}
